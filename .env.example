# ===== Blog =====
BLOG_TITLE="Mi blog"
BLOG_DESCRIPTION="Notas, ideas y cosas que voy aprendiendo"
# URL con la que entras al blog (la IP local del servidor)
BLOG_URL=http://192.168.1.100
APP_TIMEZONE=America/El_Salvador

# ===== Puertos =====
WEB_PORT=80
# El admin no tiene login: por eso solo escucha en 127.0.0.1 del servidor.
# Entra con un túnel SSH:  ssh -L 8080:localhost:8080 usuario@servidor
ADMIN_BIND=127.0.0.1
ADMIN_PORT=8080

# ===== Claves de Laravel (una por app) =====
# Genera cada una con:  echo "base64:$(openssl rand -base64 32)"
WEB_APP_KEY=
ADMIN_APP_KEY=

# ===== MySQL =====
MYSQL_DATABASE=blog
MYSQL_ROOT_PASSWORD=cambia_esto
# Usuario con permisos completos (lo usa admin)
MYSQL_ADMIN_USER=blog_admin
MYSQL_ADMIN_PASSWORD=cambia_esto
# Usuario de la web: lee todo, solo AÑADE comentarios y visitas
MYSQL_WEB_USER=blog_web
MYSQL_WEB_PASSWORD=cambia_esto

# ===== Copias de seguridad (carpeta ./backups) =====
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
